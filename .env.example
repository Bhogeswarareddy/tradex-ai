# ==============================================================================
# TradeX AI - Production Multi-Container Environment Template (.env.example)
# Copy this file to .env: cp .env.example .env
# ==============================================================================

# Application Environment (production / staging / development)
ENV=production
PROJECT_NAME="TradeX AI"
API_V1_STR=/api/v1
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32bytes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend Host & CORS
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=https://localhost,https://127.0.0.1,http://localhost

# PostgreSQL 16 Database Configuration (Isolated in backend_net)
POSTGRES_DB=tradex
POSTGRES_USER=tradex_user
POSTGRES_PASSWORD=tradex_production_secure_password_here
DATABASE_URL=postgresql+asyncpg://tradex_user:tradex_production_secure_password_here@db:5432/tradex
SYNC_DATABASE_URL=postgresql+psycopg2://tradex_user:tradex_production_secure_password_here@db:5432/tradex

# AI Provider Configuration (mock / claude / deterministic_fallback)
AI_PROVIDER=deterministic_fallback
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Storage & Document Volume
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/storage
SHIPMENT_SIMULATOR=on

# Production TLS / Domain Settings
DOMAIN=localhost
EMAIL=admin@tradex.ai
STAGING=0

# AWS ECR & Deployment Parameters (For EC2 & CI/CD)
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
ECR_REGISTRY=
IMAGE_TAG=latest
S3_BACKUP_BUCKET=

