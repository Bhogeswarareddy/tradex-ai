# ==============================================================================
# TradeX AI - Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="TradeX AI"
API_V1_STR=/api/v1
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32bytes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80

# Database Configuration (PostgreSQL 16 with pgvector)
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=tradex
POSTGRES_USER=tradex_user
POSTGRES_PASSWORD=tradex_password
DATABASE_URL=postgresql+asyncpg://tradex_user:tradex_password@db:5432/tradex

# AI Provider Configuration
# Supported providers: anthropic, deterministic_fallback
AI_PROVIDER=deterministic_fallback
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
EMBEDDING_MODEL=text-embedding-3-small

# Storage Configuration
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=tradex-ai-documents

# AWS & Deployment Placeholders
AWS_ACCOUNT_ID=
AWS_ECR_REPOSITORY=tradex-ai
