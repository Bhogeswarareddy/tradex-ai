# ==============================================================================
# TradeX AI - Environment Configuration Example
# ==============================================================================

# Core Application Settings
ENV=development
PROJECT_NAME="TradeX AI"
SECRET_KEY="development-secret-key-tradex-32bytes-secure"
ACCESS_TOKEN_MINUTES=1440
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:80,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:80"

# Database Configuration (PostgreSQL with pgvector)
POSTGRES_DB=tradex
POSTGRES_USER=tradex_user
POSTGRES_PASSWORD=tradex_password
DATABASE_URL="postgresql+asyncpg://tradex_user:tradex_password@db:5432/tradex"
SYNC_DATABASE_URL="postgresql+psycopg2://tradex_user:tradex_password@db:5432/tradex"

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE_MB=10

# ------------------------------------------------------------------------------
# AI Provider Configuration (Default: Free Offline Demo AI)
# ------------------------------------------------------------------------------
# Supported Providers: mock | ollama | openrouter | groq | gemini | anthropic
AI_PROVIDER=mock
AI_MODEL=qwen2.5:3b
AI_TIMEOUT_SECONDS=30.0
AI_PROVIDER_PRIORITY="groq,openrouter,ollama,gemini"

# Vector Embeddings (1536 dimension matching pgvector schema)
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Local Inference (Ollama)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL=qwen2.5:3b

# Free Cloud Tier (OpenRouter)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.1-8b-instruct:free"

# High-Speed Cloud Inference (Groq)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.1-8b-instant"

# Google Gemini (Optional)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Anthropic Claude (Optional commercial production)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"
